{
  "name": "bayt-mustaqbal-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:remote": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "migrate": "wrangler d1 migrations apply bayt-mustaqbal-db --local",
    "migrate:remote": "wrangler d1 migrations apply bayt-mustaqbal-db --remote",
    "migrate:create": "wrangler d1 migrations create bayt-mustaqbal-db",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/zod-validator": "^0.4.0",
    "zod": "^3.23.0",
    "jose": "^5.9.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240903.0",
    "wrangler": "^3.80.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/bcryptjs": "^2.4.6"
  }
}